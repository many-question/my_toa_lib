// Testbench tb_pss_pnoise of the interface l3-comparator-v2: the test RISCA_JL:_tb_L3_comparator_V1:1 of the Virtuoso cell RISCA_JL/_tb_L3_comparator_V1, exported by toa-virtuoso.
// @RNL(type="header") {
//   @VERSION("0.4");
//   @USE-PACKAGE(name="rnl-std-all", version="0.4");
//   @USE-PACKAGE(name="rnl-std-fill") {};
//   @USE-PACKAGE(name="eda-symbol", version="0.2", path="eda-symbol.rnl");
