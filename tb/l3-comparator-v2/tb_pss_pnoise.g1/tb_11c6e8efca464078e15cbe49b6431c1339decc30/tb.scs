simulator lang=spectre
global 0
V0 (CLK 0) vsource type=pulse val0=0 val1=VDD period=200p delay=100p \
        rise=30p fall=30p
V3 (net10 0) vsource dc=VCM-Vin/2 type=dc
V2 (net11 0) vsource dc=VCM+Vin/2 type=dc
V1 (VDD 0) vsource dc=VDD type=dc
C3 (DCMPP 0) capacitor c=2f
C2 (DCMPN 0) capacitor c=2f
C1 (net10 VINN) capacitor c=150f
C0 (net11 VINP) capacitor c=150f
R1 (net10 VINN) resistor r=1G isnoisy=no
R0 (net11 VINP) resistor r=1G isnoisy=no
I0 (CLK DCMPN DCMPP 0 VDD 0 0 0 VDD VINN VINP) L3_comparator_V2
