/* Symbol of the subcircuit tx_cp_timing_pdk110_78 of pll. */
@RNL(type="header") {
  @VERSION("0.4");
  @PACKAGE(name="tx-cp-timing-pdk110-78-sym", version="0.1")
}
@RNL {
  $TX_CP_TIMING_PDK110_78_BLOCK = @DEFINE-SYMBOL(box=[-5, -3, 5, 3]) {
    (-5, 2)  @PIN(terminal=1, label="REF", direction="left");
    (-5, 0)  @PIN(terminal=2, label="EN", direction="left");
    (-5, -2) @PIN(terminal=3, label="RST", direction="left");
    (5, 0)   @PIN(terminal=4, label="PULSE", direction="right");
    @LINE { (-5, 2) (-4, 2) };
    @LINE { (-5, 0) (-4, 0) };
    @LINE { (-5, -2) (-4, -2) };
    @LINE { (4, 0) (5, 0) };
    (0, 0) @RECTANGLE(width=8, height=5);
    /* Delay chain buffer triangle + narrow one-shot pulse waveform */
    @LINE { (-2.0, 0.9) (-0.6, 0.2) (-2.0, -0.5) (-2.0, 0.9) };
    @LINE { (-0.2, -0.8) (0.4, -0.8) (0.4, 1.2) (1.2, 1.2) (1.2, -0.8) (1.9, -0.8) };
    ? @TEXT("${name}", key="name", halign="middle", size=0.65) => @PLACE(0, 3.1)
  };
  # @SELECT-INSTANCE(model="tx_cp_timing_pdk110_78", recursive=true) => @SET-SYMBOL $TX_CP_TIMING_PDK110_78_BLOCK
}
