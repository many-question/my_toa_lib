    (19.4, -2) @TEXT("VOUTN", size=1, halign="end", valign="middle");
    (0, 0) @PIN(terminal=["VINP_2", "VINP_1"]);
    (0.6, 1) @TEXT("VINP<2:1>", size=1, halign="start", valign="middle");
    (0, -10) @PIN(terminal="GND");
