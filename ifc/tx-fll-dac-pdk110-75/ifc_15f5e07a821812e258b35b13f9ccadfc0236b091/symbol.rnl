/* Symbol of the subcircuit tx_fll_dac_pdk110_75 of pll. */
@RNL(type="header") {
  @VERSION("0.4");
  @PACKAGE(name="tx-fll-dac-pdk110-75-sym", version="0.1")
}
@RNL {
  $TX_FLL_DAC_PDK110_75_BLOCK = @DEFINE-SYMBOL(box=[-5, -3, 5, 3]) {
    (-5, 1)  @PIN(terminal=[1, 2, 3, 4, 5, 6], label="D<5:0>", direction="left");
    (-5, -1) @PIN(terminal=7, label="EN_B", direction="left");
    (5, 0)   @PIN(terminal=8, label="OUT", direction="right");
    @LINE { (-5, 1) (-4, 1) };
    @LINE { (-5, -1) (-4, -1) };
    @LINE { (4, 0) (5, 0) };
    (0, 0) @RECTANGLE(width=8, height=4);
    /* DAC converter polygon + analog staircase output waveform */
    @LINE { (-1.6, 1.4) (1.0, 1.4) (2.2, 0.0) (1.0, -1.4) (-1.6, -1.4) (-1.6, 1.4) };
    @LINE { (-1.2, -0.8) (-0.6, -0.8) (-0.6, -0.3) (0.0, -0.3) (0.0, 0.2) (0.6, 0.2) (0.6, 0.7) (1.2, 0.7) };
    ? @TEXT("${name}", key="name", halign="middle", size=0.65) => @PLACE(0, 2.6)
  };
  # @SELECT-INSTANCE(model="tx_fll_dac_pdk110_75", recursive=true) => @SET-SYMBOL $TX_FLL_DAC_PDK110_75_BLOCK
}
