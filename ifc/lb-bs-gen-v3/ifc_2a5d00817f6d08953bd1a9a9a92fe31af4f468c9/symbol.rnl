/* Symbol of the Virtuoso cell RISCA_JL/LB_bs_gen_V3, exported by rnl-virtuoso. */
@RNL(type="header") {
  @VERSION("0.4");
  @PACKAGE(name="lb-bs-gen-v3-sym", version="0.1")
}
@RNL {
  $LB_BS_GEN_V3_BLOCK = @DEFINE-SYMBOL(box=[0, -5, 14, 9]) {
    @LINE {(0, 4) (6, 4)};
    @LINE {(0, 0) (6, 0)};
    @LINE {(0, -4) (7, -4)};
    @LINE {(7, 9) (7, 5)};
    @LINE {(7, -4) (7, -1)};
    @LINE {(7, 3) (7, 1)};
    (7, 4) @CIRCLE(radius=1);
    @LINE {(6, 2) (6, -2) (9, 0) (6, 2)};
    @RECTANGLE {(4, -5) (10, 7)};
    @LINE {(14, 0) (9, 0)};
    (7, 3) @TEXT("+", size=1, halign="middle", valign="baseline");
    (7, 4) @TEXT("-", size=1, halign="middle", valign="baseline");
    ? @TEXT("${name}", size=1, halign="start", valign="middle", key="name") => @PLACE(10, 4);
    ? @TEXT("${model}", size=1, halign="middle", valign="middle", key="model") => @PLACE(7, -6);
    (7, 9) @PIN(terminal="VIN");
    (4.6, 8) @TEXT("VIN", size=1, halign="start", valign="middle");
    (0, 4) @PIN(terminal="VDD");
    (0.6, 5) @TEXT("VDD", size=1, halign="start", valign="middle");
    (0, -4) @PIN(terminal="VSS");
    (0.6, -3) @TEXT("VSS", size=1, halign="start", valign="middle");
    (14, 0) @PIN(terminal="CLKBS");
    (13.4, 1) @TEXT("CLKBS", size=1, halign="end", valign="middle");
    (0, 0) @PIN(terminal="CLK");
    (0.6, 1) @TEXT("CLK", size=1, halign="start", valign="middle")
  };
  # @SELECT-INSTANCE(model="LB_bs_gen_V3", recursive=true) => @SET-SYMBOL(terminals=["CLK", "CLKBS", "VDD", "VIN", "VSS"]) $LB_BS_GEN_V3_BLOCK
}
